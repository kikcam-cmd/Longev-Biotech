# ---- Core (Medusa Cloud injects DATABASE_URL / REDIS_URL automatically) ----
DATABASE_URL=postgres://user:pass@host:5432/longev_medusa
REDIS_URL=redis://localhost:6379

# Secrets — generate long random strings for production
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# CORS — your storefront + admin origins (comma-separated)
STORE_CORS=http://localhost:8000,https://www.longevbiotech.com
ADMIN_CORS=http://localhost:9000,https://admin.longevbiotech.com
AUTH_CORS=http://localhost:8000,https://www.longevbiotech.com

# ---- NMI high-risk payment gateway ----
# From your NMI portal: Settings → Security Keys. Tied to YOUR merchant account (MID).
NMI_SECURITY_KEY=
# Use the gateway emulator / sandbox key first, then swap to live.
NMI_API_URL=https://secure.nmi.com/api/transact.php
# Optional: secret used to verify inbound NMI webhooks (Settings → Webhooks).
NMI_WEBHOOK_SECRET=
