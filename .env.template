# ============================================================================
# Medusa Cloud injects these automatically — DO NOT set them yourself on Cloud.
# (Only fill them in for local dev against your own Postgres/Redis.)
# ============================================================================
DATABASE_URL=postgres://user:pass@host:5432/longev_medusa
REDIS_URL=redis://localhost:6379

# ============================================================================
# YOU MUST SET THESE on Medusa Cloud (Project → Environment Variables)
# ============================================================================
# Secrets — generate long random strings (e.g. `openssl rand -base64 32`)
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# CORS — comma-separated origins.
#   STORE_CORS  = storefront origin(s)        (localhost:8000 + future longevbiotech.com)
#   ADMIN_CORS  = the Medusa backend/admin URL (your Cloud app URL)
#   AUTH_CORS   = storefront + admin origins
STORE_CORS=http://localhost:8000,https://www.longevbiotech.com
ADMIN_CORS=http://localhost:9000,https://admin.longevbiotech.com
AUTH_CORS=http://localhost:8000,https://www.longevbiotech.com,https://admin.longevbiotech.com

# NMI is a PLACEHOLDER payment provider (no processor chosen yet). Its
# validateOptions() throws if this is empty, which blocks boot — so set ANY
# non-empty value to let the backend start. Swap for a real key once a
# high-risk processor is selected, or remove the NMI block from medusa-config.ts.
NMI_SECURITY_KEY=placeholder
NMI_API_URL=https://secure.nmi.com/api/transact.php
NMI_WEBHOOK_SECRET=

# ============================================================================
# Optional — confirm whether Medusa Cloud sets this for you before adding it.
# ============================================================================
# MEDUSA_BACKEND_URL=https://<your-cloud-app-url>
