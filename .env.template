# ============================================================================
# Medusa Cloud injects these automatically — DO NOT set them yourself on Cloud.
# (Only fill them in for local dev against your own Postgres/Redis.)
# ============================================================================
DATABASE_URL=postgres://user:pass@host:5432/longev_medusa
REDIS_URL=redis://localhost:6379

# ============================================================================
# YOU MUST SET THESE on Medusa Cloud (Project → Environment Variables)
# ============================================================================
# Secrets — generate long random strings (e.g. `openssl rand -base64 32`)
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# CORS — comma-separated origins.
#   STORE_CORS  = storefront origin(s)        (localhost:8000 + future longevbiotech.com)
#   ADMIN_CORS  = the Medusa backend/admin URL (your Cloud app URL)
#   AUTH_CORS   = storefront + admin origins
STORE_CORS=http://localhost:8000,https://www.longevbiotech.com
ADMIN_CORS=http://localhost:9000,https://admin.longevbiotech.com
AUTH_CORS=http://localhost:8000,https://www.longevbiotech.com,https://admin.longevbiotech.com

# NMI is a PLACEHOLDER payment provider (no processor chosen yet). Its
# validateOptions() throws if this is empty, which blocks boot — so set ANY
# non-empty value to let the backend start. Swap for a real key once a
# high-risk processor is selected, or remove the NMI block from medusa-config.ts.
NMI_SECURITY_KEY=placeholder
NMI_API_URL=https://secure.nmi.com/api/transact.php
NMI_WEBHOOK_SECRET=

# ============================================================================
# S3-compatible file storage for product media + CoA PDFs.
# Configured for CLOUDFLARE R2 (recommended). If S3_BUCKET is unset, Medusa falls
# back to its local file provider (dev only — ephemeral on Cloud, so not for prod).
#
# How to get these from the Cloudflare dashboard (R2):
#   1. R2 → Create bucket  (e.g. "longev-media").
#   2. R2 → Manage API Tokens → Create token (Object Read & Write, scoped to the
#      bucket). Copy the Access Key ID + Secret Access Key.
#   3. Account ID is in the bucket's "S3 API" endpoint:
#      https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   4. Make the bucket PUBLIC so product images load on the storefront:
#      bucket → Settings → Public access → either enable the r2.dev URL OR bind a
#      custom domain (e.g. media.longevbiotech.com). Use that as S3_FILE_URL.
#
# CoA note: R2 access is bucket-level, so on a public bucket a CoA PDF is protected
# only by its unguessable random key (not a true private ACL). Fine for launch; if
# stricter CoA privacy is needed later, move CoA to a separate private R2 bucket.
# ============================================================================
# S3_BUCKET=longev-media
# S3_REGION=auto                   # R2 always uses "auto"
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3 API endpoint (NOT the public URL): https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# PUBLIC base URL of the bucket, no trailing slash. The r2.dev URL or your custom domain:
#   r2.dev:        https://pub-<hash>.r2.dev
#   custom domain: https://media.longevbiotech.com
# S3_FILE_URL=https://pub-<hash>.r2.dev
# Optional overrides:
# S3_PREFIX=                       # key prefix inside the bucket (default: none / root)
# S3_DOWNLOAD_DURATION=300         # CoA signed-URL lifetime in seconds (default 5 min)
# S3_FORCE_PATH_STYLE=false        # leave false for R2; set true only if uploads 404/fail
# (Request/response checksums are auto-set to WHEN_REQUIRED in medusa-config.ts so R2
#  doesn't reject uploads — no env needed.)

# Admin media-upload size cap in BYTES. Medusa's default is 1MB (1048576), too small
# for product photos. Defaults to 25MB in medusa-config.ts; override here if needed.
# NOTE: baked into the admin bundle at build time — rebuild + redeploy to take effect.
# ADMIN_MAX_UPLOAD_FILE_SIZE=26214400

# ============================================================================
# Optional — confirm whether Medusa Cloud sets this for you before adding it.
# ============================================================================
# MEDUSA_BACKEND_URL=https://<your-cloud-app-url>
